page { min-height: 100%; background: #f4f6f8; }
.cu-custom { position: absolute; top: 0; width: 100%; z-index: 5; }
.cu-custom .cu-bar { color: #222; }
.ticket-page { padding: 24rpx 24rpx 48rpx; }
.page-title { color: #17232d; font-size: 38rpx; font-weight: 700; }
.page-subtitle { margin: 8rpx 0 28rpx; color: #82909b; font-size: 24rpx; }
.package-card { display: flex; overflow: hidden; margin-bottom: 24rpx; padding: 18rpx; border-radius: 16rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(24, 44, 62, .06); }
.package-image { flex: none; width: 190rpx; height: 190rpx; border-radius: 10rpx; background: #eef5f8; }
.package-info { flex: 1; min-width: 0; padding: 4rpx 0 0 20rpx; }
.package-name { overflow: hidden; color: #202831; font-size: 29rpx; font-weight: 600; white-space: nowrap; text-overflow: ellipsis; }
.package-product, .package-count { margin-top: 12rpx; color: #7d8993; font-size: 22rpx; }
.package-count { color: #2589d8; }
.price-row { display: flex; align-items: center; margin-top: 18rpx; }
.sale-price { color: #e84b45; font-size: 36rpx; font-weight: 700; }
.original-price { margin-left: 12rpx; color: #9ca5ad; font-size: 23rpx; text-decoration: line-through; }
.buy-button { flex: none; width: 128rpx; height: 54rpx; margin: 0 0 0 auto; padding: 0; border-radius: 28rpx; background: #2189e8; color: #fff; font-size: 22rpx; line-height: 54rpx; }
.empty { padding: 180rpx 0; color: #9aa4ad; text-align: center; }
