<view class="cu-custom" style="height:{{CustomBar}}px;">
  <view class="cu-bar fixed bg-white" style="height:{{CustomBar}}px;padding-top:{{StatusBar}}px;">
    <view class="action" bindtap="back"><text class="icon-back"></text> 水票中心</view>
  </view>
</view>
<view class="ticket-page" style="padding-top:{{CustomBar}}px;">
  <view class="page-title">电子水票</view>
  <view class="page-subtitle">选择套餐，购买后可在下单时抵扣对应商品</view>
  <view class="package-list">
    <view class="package-card" wx:for="{{packages}}" wx:key="id">
      <image class="package-image" src="{{imageBaseUrl}}{{item.image}}" mode="aspectFill"></image>
      <view class="package-info">
        <view class="package-name">{{item.name}}</view>
        <view class="package-product">适用商品：{{item.commodityName}}</view>
        <view class="package-count">{{item.ticketNum}} 桶 · 有效 {{item.validDays}} 天</view>
        <view class="price-row">
          <text class="sale-price">¥{{item.discountPrice}}</text>
          <text wx:if="{{item.hasDiscount}}" class="original-price">¥{{item.originalPrice}}</text>
          <button class="buy-button" data-id="{{item.id}}" bindtap="purchase">查看商品</button>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{packages.length === 0}}" class="empty">暂无在售水票</view>
</view>
