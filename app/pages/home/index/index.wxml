<!--轮播区域-->
<swiper wx:if="{{swiperlist.length}}" current="{{current}}" class="screen-swiper square-dot shadow-warp bg-white" indicator-dots="{{swiperlist.length > 1}}" circular="{{swiperlist.length > 1}}" autoplay="{{swiperlist.length > 1}}" interval="5000" duration="500" bindchange="swiperchange">
    <swiper-item wx:for="{{swiperlist}}" wx:key="id">
        <image src="{{item.url}}" mode='aspectFill'></image>
    </swiper-item>
</swiper>

<!--宫格功能区域-->
<view class="cu-list grid col-4 no-border">
    <block wx:for="{{iconList}}" wx:key="id">
        <view class="shortcut-item" bindtap="itemckcred" data-index="{{item.id}}" data-itemtype="{{item.type}}">
            <view class="shortcut-icon shortcut-{{item.type}}">
                <text class="shortcut-glyph {{item.iconClass}}"></text>
            </view>
            <text class="shortcut-label">{{item.name}}</text>
        </view>
    </block>
</view>

<!--视频区域-->
<!-- <video class="canui-video shadow-warp bg-white" src="{{videosrc}}"></video> -->

<!--热销推荐-->
<view class="cu-bar bg-white margin-top solid-bottom">
    <view class='action'>
        <text class='icon-title text-green'></text>
        <text>热销推荐</text>
    </view>

</view>
<view class="bg-white" style="padding:0 30rpx;padding-bottom: 20rpx;">
    <view class="product-grid">
        <navigator wx:for="{{commodityHot}}" wx:key="id" open-type="navigate" hover-class="none" url="/pages/shop/goods/details?commodityId={{item.id}}" class="product-card">
            <view class="product-image-wrap">
                <image wx:if="{{item.imageUrl}}" class="product-image" src="{{item.imageUrl}}" mode="aspectFill" binderror="onProductImageError" data-id="{{item.id}}"></image>
                <view wx:else class="product-image-placeholder"><text class="icon-goods"></text></view>
            </view>
            <view class="product-info">
                <view class="product-name">{{item.name}}</view>
                <view class="product-sales">销量 {{item.orderNum || 0}}</view>
                <view class="home-price">¥{{item.price}}</view>
            </view>
        </navigator>
    </view>
</view>
