page {
    padding-top: 50px;
    padding-bottom:20rpx;
}
.head-title{
    margin: 0 auto;
}
.cu-custom .cu-bar{
    padding-right:inherit;
    /* background-image:linear-gradient(45deg, rgb(15, 112, 65), rgb(15, 112, 65)); */
    background-image:linear-gradient(45deg, rgb(15, 112, 65), rgb(15, 112, 65));
}
.bg-gradual-green {
    background-image:linear-gradient(45deg, rgb(15, 112, 65), rgb(15, 112, 65));
}
.text-green, .line-green, .lines-green {
    color:#e45c5c;
}
.swiperitem{
    background: #fff;
    height:55px;
}
.cu-list.grid.col-4 { display: flex; justify-content: center; padding: 24rpx 16rpx; background: #fff; }
.cu-list.grid.col-4 .shortcut-item { width: 50%; display: flex; flex-direction: column; align-items: center; padding: 8rpx 0; }
.shortcut-icon { width: 88rpx; height: 88rpx; border-radius: 50%; display:flex; align-items:center; justify-content:center; box-shadow: 0 12rpx 24rpx rgba(0,0,0,.12); }
.shortcut-1 { color: #fff; background: linear-gradient(145deg, #50c9b0, #15977e); }
.shortcut-2 { color: #fff; background: linear-gradient(145deg, #ffb06c, #f05b4d); }
.shortcut-glyph { font-size: 40rpx; line-height: 1; }
.shortcut-label { margin-top: 10rpx; color: #303841; font-size: 24rpx; line-height: 1.4; }
.shortcut-item:active .shortcut-icon { transform: scale(.94); }
.home-price { margin-top: 10rpx; color: #e84b45; font-size: 30rpx; font-weight: 700; }
.canui-video{
    width: 100%;
    height: 425rpx;
}
.product-grid { display:flex; flex-wrap:wrap; margin: 0 -12rpx; padding-top: 12rpx; }
.product-card { display:block; box-sizing:border-box; min-width:0; width:50%; padding: 0 12rpx 24rpx; overflow:hidden; border-radius:18rpx; }
.product-card > view { overflow:hidden; background:#fff; }
.product-card .product-image-wrap { height:340rpx; background:#f6f7f8; border-radius:18rpx 18rpx 0 0; }
.product-image { display:block; width:100%; height:100%; }
.product-image-placeholder { width:100%; height:100%; display:flex; align-items:center; justify-content:center; color:#c6ccd2; font-size:64rpx; }
.product-info { min-height:150rpx; padding:16rpx 18rpx 18rpx; border-radius:0 0 18rpx 18rpx; box-shadow:0 8rpx 24rpx rgba(31,45,61,.08); }
.product-name { overflow:hidden; color:#27313a; font-size:27rpx; line-height:1.45; height:78rpx; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; }
.product-sales { margin-top:6rpx; color:#9aa2a9; font-size:21rpx; }
.canui-gps .justify-between{
    padding: 0 10px;
}

.content .text-sm{
    overflow:hidden;
    text-overflow:ellipsis;
    display:-webkit-box;
    -webkit-box-orient:vertical;
    -webkit-line-clamp:1;
}
.content .text-titile{
    font-size: 13px;
    overflow:hidden;
    text-overflow:ellipsis;
    display:-webkit-box;
    -webkit-box-orient:vertical;
    -webkit-line-clamp:1;
}
.canui-fixed{
    position: fixed;
    bottom: 0px;
    width: 100%;
    z-index:999999;
}
