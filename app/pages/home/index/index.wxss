page {
    padding-top: 50px;
    padding-bottom:20rpx;
}
.head-title{
    margin: 0 auto;
}
.cu-custom .cu-bar{
    padding-right:inherit;
    /* background-image:linear-gradient(45deg, rgb(15, 112, 65), rgb(15, 112, 65)); */
    background-image:linear-gradient(45deg, rgb(15, 112, 65), rgb(15, 112, 65));
}
.bg-gradual-green {
    background-image:linear-gradient(45deg, rgb(15, 112, 65), rgb(15, 112, 65));
}
.text-green, .line-green, .lines-green {
    color:#e45c5c;
}
.swiperitem{
    background: #fff;
    height:55px;
}
.cu-list.grid.col-4 { display: flex; justify-content: flex-start; padding: 22rpx 16rpx; background: #fff; }
.cu-list.grid.col-4 .cu-item { width: 50%; padding: 10rpx 0; }
.shortcut-icon { width: 82rpx; height: 82rpx; margin: 0 auto 10rpx; border-radius: 50%; display:flex; align-items:center; justify-content:center; background:#f2e8f2; color:#87477f; font-size:36rpx; font-weight:700; }
.cu-list.grid.col-4 .cu-item text { color:#303841; font-size:25rpx; }
.cu-list.grid.col-4 .cu-item .shortcut-icon { color:#87477f; font-size:36rpx; }
.home-price { margin-top: 8rpx; color: #e84b45; font-size: 27rpx; font-weight: 700; }
.canui-video{
    width: 100%;
    height: 425rpx;
}
.nav-list,.nav-li{
    padding: 0px;
    z-index: 0;
}
.canui-yx-url{
    width:46% !important;
    margin:0 2% 30rpx !important;
}
.canui-flex-car{
    padding-top: 10px;
}
.canui-flex-car .cu-card>.cu-item {
    margin: 0px;
    position: relative;
}
.canui-flex-car .cu-list.menu-avatar>.cu-item {
    padding-left:15rpx;
    height:100rpx;
}
.canui-flex-car .cu-card .cu-avatar{
    position:absolute;
    right:10px;
    bottom:72rpx;
}
.canui-flex-car .shadow-warp {
    box-shadow:0 0 30rpx rgba(0, 0, 0, 0.1);
}
.canui-flex-car .cu-list.menu>.cu-item .content {
    font-size:26rpx;
}
.canui-flex-car .text-sm {
    font-size:20rpx;
}
.canui-flex-car .text-grey {
    color: #000;
}
.canui-flex-car image{
    height: 90px !important;
}
.canui-gps .justify-between{
    padding: 0 10px;
}

.content .text-sm{
    overflow:hidden;
    text-overflow:ellipsis;
    display:-webkit-box;
    -webkit-box-orient:vertical;
    -webkit-line-clamp:1;
}
.content .text-titile{
    font-size: 13px;
    overflow:hidden;
    text-overflow:ellipsis;
    display:-webkit-box;
    -webkit-box-orient:vertical;
    -webkit-line-clamp:1;
}
.canui-fixed{
    position: fixed;
    bottom: 0px;
    width: 100%;
    z-index:999999;
}
