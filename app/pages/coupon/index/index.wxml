<view class="cu-custom" style="height:{{CustomBar}}px;">
  <view class="cu-bar fixed bg-white" style="height:{{CustomBar}}px;padding-top:{{StatusBar}}px;">
    <view class="action" bindtap="back"><text class="icon-back"></text> 优惠中心</view>
  </view>
</view>
<view class="coupon-page" style="padding-top:{{CustomBar}}px;">
  <view class="coupon-banner">
    <view class="banner-title">领券享优惠</view>
    <view class="banner-subtitle">好券上新 · 下单立减</view>
    <view class="banner-ticket">¥</view>
  </view>
  <view class="coupon-tabs">
    <view wx:for="{{tabs}}" wx:key="id" class="coupon-tab {{current === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectTab">{{item.label}}</view>
  </view>
  <view class="coupon-list">
    <view class="coupon-card" wx:for="{{coupons}}" wx:key="id">
      <view class="coupon-value">
        <view class="value-text">{{item.valueText}}</view>
        <view class="condition-text">{{item.conditionText}}</view>
      </view>
      <view class="coupon-content">
        <view class="coupon-tag">{{item.couponType === 'ALL' ? '全场优惠' : '指定商品'}}</view>
        <view class="coupon-name">{{item.name}}</view>
        <view class="coupon-scope">{{item.scopeText}}</view>
        <view class="coupon-valid">{{item.availableText}}</view>
      </view>
      <button wx:if="{{!item.claimed && item.available}}" class="claim-button" data-id="{{item.id}}" bindtap="claim">立即领取</button>
      <view wx:elif="{{item.claimed}}" class="claimed-label">已领取</view>
      <view wx:else class="claimed-label">暂不可领</view>
    </view>
    <view wx:if="{{coupons.length === 0}}" class="empty">暂无优惠券</view>
  </view>
</view>
