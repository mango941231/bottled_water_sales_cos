<!-- 商品轮播图 -->
<swiper wx:if="{{swiperlist.length}}" class="screen-swiper square-dot bg-white" indicator-dots="{{swiperlist.length > 1}}" circular="{{swiperlist.length > 1}}" autoplay="{{swiperlist.length > 1}}" interval="5000" duration="500">
    <swiper-item wx:for="{{swiperlist}}" wx:key="index">
        <image src="{{item}}" mode="aspectFit" binderror="onDetailImageError" data-index="{{index}}"></image>
    </swiper-item>
</swiper>
<view wx:else class="detail-image-placeholder"><text class="icon-goods"></text></view>
<!-- 左上角按钮 -->
<view class="canui-head-box" style="top:{{StatusBar}}px;">
    <navigator class='icon-back' open-type="navigateBack" hover-class="none"></navigator>
    <navigator class='icon-home' open-type="navigateBack" hover-class="none"></navigator>
</view>
<!-- 商品价格 -->
<view wx:if="{{goods}}" class="bg-white canui-goods-box" style="padding-top:30rpx;">
    <text class="text-price text-red text-xl">{{ goods.price }}</text>
</view>
<!-- 商品名称 -->
<view wx:if="{{goods}}" class="bg-white canui-goods-box canui-xzwz text-black">
    {{ goods.name }}
    <view wx:if="{{ goods.onPut == 0 }}" class="cu-tag bg-blue radius sm">下架中</view>
</view>
<!-- 商品属性 -->
<view wx:if="{{goods}}" class="bg-white grid col-2 canui-goods-box text-gray text-sm">
    <view class="padding-sm">分类：{{goods.typeName || '商品'}}</view>
    <view class="padding-sm text-right">规格：{{goods.model || '-'}}</view>
    <view class="padding-sm">库存：{{goods.stockNum || 0}}</view>
    <view class="padding-sm text-right">销量：{{goods.orderNum || 0}} 笔</view>
</view>
<!-- 商品详情 -->
<view wx:if="{{goods}}" class="cu-bar bg-white margin-top solid-bottom">
    <view class='action'>
        <text class='icon-title text-red'></text>
        <text>商品详情</text>
    </view>
</view>
<view wx:if="{{goods}}" class="bg-white padding cauni-details-box">{{ goods.content || '暂无商品详情' }}</view>
<view class="cu-bar bg-white margin-top solid-bottom" wx:if="{{ticketPackages.length}}">
    <view class="action"><text class="icon-title text-red"></text><text>商品水票</text></view>
</view>
<view class="cu-list menu" wx:if="{{ticketPackages.length}}">
    <view class="cu-item" wx:for="{{ticketPackages}}" wx:key="id">
        <view class="content">
            <view>{{item.name}} · {{item.ticketNum}} 桶</view>
            <view class="text-gray text-sm">{{item.validDays}} 天有效</view>
        </view>
        <view class="action">
            <text class="text-price text-red">{{item.price}}</text>
            <button class="cu-btn bg-red sm margin-left" data-id="{{item.id}}" bindtap="buyTicket" loading="{{buyTicketBusy}}">购买</button>
        </view>
    </view>
</view>
<!-- 商品评价 -->
<view class="cu-bar bg-white margin-top solid-bottom">
    <view class='action'>
        <text class='icon-title text-red'></text>
        <text>商品评价</text>
    </view>
</view>
<view class="cu-list menu-avatar bg-white comment" style="padding-bottom: 50px">
    <view class="cu-item" wx:for="{{evaluation}}">
        <view class="cu-avatar round" style="background-image:url({{item.avatar}});"></view>
        <view class="content">
            <view class="text-grey">{{item.userName}}</view>
            <view class="text-gray text-content text-df" style="font-size: 12px;margin-top: 5px">{{item.content}}</view>
            <view class="margin-top-sm flex justify-between">
                <view class="text-gray text-df">{{item.createDate}}</view>
                <view>
                    <text class="cuIcon-appreciatefill text-red"></text>
                    <text class="cuIcon-messagefill text-gray margin-left-sm"></text>
                </view>
            </view>
        </view>
    </view>
    <view wx:if="{{ evaluation.length === 0 }}" style="padding-bottom: 50px;text-align: center;padding-top: 20px;">暂无评价信息</view>
</view>
<!-- TabbarBot为适配全面屏的，如果是全面屏，则底部多出一截空白 -->
<view class="cu-bar bg-white tabbar border shop canui-foor-fixed {{TabbarBot=='y'?'canui-tabbar-bottom':''}}">
    <view class="action text-grey" bindtap='homeView'>
        <view class='icon-home text-red'></view>
        首页
    </view>
    <button class="action text-grey" open-type="contact">
        <view class='icon-service'></view>
        客服
    </button>
    <view class="action text-grey" bindtap='cartView'>
        <view class='icon-cart'></view>
        购物车
    </view>
    <view class='btn-group'>
        <button class='cu-btn bg-orange round shadow-blur' bindtap='addCart'>加入购物车</button>
        <button class='cu-btn bg-red round shadow-blur' bindtap='buyGoods'>立即购买</button>
    </view>
</view>
