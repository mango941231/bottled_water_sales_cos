<view class="cu-custom" style="height:{{CustomBar}}px;">
  <view class="cu-bar fixed none-bg text-white bg-img" style="height:{{CustomBar}}px;padding-top:{{StatusBar}}px;">
    <view class="action canui-head-title" bindtap="btnback"><text class="icon-back"></text>商品列表</view>
  </view>
</view>
<view class="cu-bar bg-white search">
  <view class="search-form round"><text class="icon-search"></text><input value="{{key}}" bindinput="getKeyValue" bindconfirm="search" placeholder="搜索商品" /></view>
  <view class="action"><button class="cu-btn bg-green round" bindtap="search">搜索</button></view>
</view>
<view class="bg-white nav flex">
  <view wx:for="{{sortMenu}}" wx:key="id" class="cu-item flex-sub text-center {{sort == item.id ? 'text-green cur' : ''}}" bindtap="sortSelect" data-id="{{item.id}}">{{item.name}}</view>
</view>
<view class="cu-list menu menu-avatar">
  <navigator wx:for="{{goods}}" wx:key="id" class="cu-item" url="/pages/shop/goods/details?commoditId={{item.id}}">
    <view class="cu-avatar radius lg" style="background-image:url({{imageBaseUrl}}{{item.image}})"></view>
    <view class="content"><view>{{item.name}}</view><view class="text-red text-price">{{item.price}}</view></view>
    <view class="action"><view class="text-gray text-sm">销量 {{item.orderNum}}</view></view>
  </navigator>
</view>
<van-empty wx:if="{{goods.length === 0}}" description="暂无商品" />
