page {
    padding-top: 50px;
    padding-bottom:170rpx;
}
.cu-custom{
    position: absolute;
    top: 0px;
    width: 100%;
}
.cu-custom .cu-bar{
    padding-right:inherit;
    background-image:linear-gradient(45deg, rgb(15, 112, 65), rgb(15, 112, 65));
}
.box{
    position: absolute;
    top: 64px;
    width: 100%;
    padding-bottom:180rpx;
}
.canui-address{
    padding:30rpx 20rpx;
}
.canui-address .cu-list{
    position: relative;
}
.canui-address .cu-list.menu>.cu-item{
    padding: 30rpx;
}
.canui-address .cu-list .cu-item .content view text{
    margin-left: 20rpx;
}

.canui-card-order{
    padding:0 20rpx;
}
.canui-card-order .canui-order-item{
    position: relative;
    margin-bottom:30rpx;
    padding:20rpx;
    padding-bottom:0rpx;
}
.head-title-box .icon-shop{
    margin-right:10rpx;
}
.head-title-box .icon-right{
    margin-left:5rpx;
}
.canui-order-item .cu-list.menu-avatar>.cu-item{
    padding:0;
    padding-left:110rpx;
}
.canui-order-item .cu-list.menu-avatar>.cu-item>.cu-avatar{
    left:0rpx;
}
.canui-order-item .cu-list .cu-item .canui-xzwz{
    -webkit-line-clamp:2;
}
.canui-order-item .cu-list.menu>.cu-item .content{
    font-size:27rpx;
    margin-right:40rpx;
}
.canui-order-item .cu-list.menu-avatar>.cu-item .action {
    text-align:right;
    margin-top:-10rpx;
}
.canui-order-item .cu-list.menu>.cu-item .action .text-price{
    font-size:28rpx;
}
.canui-order-item .order-price-box{
    font-size:26rpx;
}
.cu-list.menu>.cu-item,.canui-input{
    min-height: 80rpx;
}
.canui-input .title,.canui-input input,.cu-list.menu>.cu-item .content{
    font-size:27rpx;
}
.cu-list.menu>.cu-item.arrow{
    padding-right:60rpx;
}

.canui-coupon{
    padding:0 20rpx;
}

.order-price-log{
    padding:0 20rpx;
    margin-top:30rpx;
}
.order-price-log .log-card{
    padding:20rpx 30rpx;
}
.order-price-log .log-list{
    padding:5rpx 0;
}
.order-price-log-zj{
    padding:20rpx 30rpx;
    background:#fafafa;
}
.canui-submit-view{
    min-height:130rpx;
    z-index:99999;
}
.canui-pay-tip{
    padding:10rpx 20rpx;
}
.canui-submit{
    height:80rpx;
    padding-left:20rpx;
}
.canui-submit .canui-price{
    line-height:80rpx;
    font-size:40rpx;
}
.canui-submit .canui-submit-btn{
    float:right;
    height:80rpx;
    line-height:80rpx;
    width:180rpx;
    text-align:center;
    font-size:26rpx;
    border-radius: 0;
    margin: 0;
    padding: 0;
}

.coupon-rule { padding: 18rpx 8rpx; font-size: 23rpx; color: #8b9299; line-height: 1.6; }
.coupon-retry { color: #0f7041; padding: 10rpx 0; }
.coupon-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 100001; background: rgba(0, 0, 0, .45); display: flex; align-items: flex-end; }
.coupon-sheet { width: 100%; padding: 30rpx 26rpx; padding-bottom: calc(30rpx + env(safe-area-inset-bottom)); background: #f7f8fa; border-radius: 28rpx 28rpx 0 0; }
.coupon-sheet-heading { display: flex; justify-content: space-between; font-size: 32rpx; font-weight: bold; }
.coupon-sheet-heading text:last-child { font-size: 26rpx; color: #8b9299; font-weight: normal; }
.coupon-none { padding: 24rpx; background: white; border-radius: 14rpx; display: flex; justify-content: space-between; }
.coupon-scroll { height: 50vh; margin-top: 20rpx; }
.checkout-coupon { display: flex; align-items: center; padding: 24rpx 18rpx; border: 2rpx solid transparent; border-radius: 14rpx; background: white; margin-bottom: 18rpx; }
.coupon-value { width: 170rpx; flex-shrink: 0; color: #eb5548; font-weight: bold; font-size: 32rpx; text-align: center; }
.coupon-info { border-left: 2rpx dashed #ececec; padding-left: 22rpx; color: #818891; font-size: 23rpx; line-height: 1.8; }
.coupon-name { font-size: 28rpx; color: #303b34; font-weight: bold; }
.coupon-disabled { opacity: .65; }
.coupon-selected { border-color: #0f7041; background: #f0faf5; }
.coupon-unavailable { color: #a15c50; }
.coupon-empty { text-align: center; padding: 60rpx 0; color: #8b9299; }
.coupon-center-link { text-align: center; padding: 20rpx 0 0; color: #0f7041; }
.canui-submit-order{
    padding-bottom: 30rpx;
}


