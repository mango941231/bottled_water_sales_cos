<!--状态栏区域-->
<view class="cu-custom" style="height:{{CustomBar}}px;">
    <view class="cu-bar fixed none-bg text-white bg-img" style="height:{{CustomBar}}px;padding-top:{{StatusBar}}px;">
        <navigator class='action canui-head-title' open-type="navigateBack" hover-class="none">
            <text class='icon-back'></text> 结算订单
        </navigator>
    </view>
</view>

<view class="box" style="top: {{CustomBar}}px;">
    <view class="canui-address">
        <view class="cu-list menu bg-white">
            <view class="cu-item">
                <view class='content'>
                    <view class="text-df">{{ addressInfo.name }} <text>{{ addressInfo.phone }}</text></view>
                    <view class='text-gray text-sm canui-xzwz'>{{ addressInfo.address }}</view>
                </view>
                <!-- <view class='action'><view class='text-grey icon-right'></view></view> -->
            </view>
            <view class="canui-lines"></view>
        </view>
    </view>

    <view class="canui-card-order">
        <view class="canui-order-item bg-white" wx:for="{{ orderList }}">
            <navigator open-type="navigate" hover-class='none' url="/pages/shop/goods/details?commoditId={{item.id}}">
                <view class="cu-list menu menu-avatar">
                    <view class="cu-item">
                        <view class="cu-avatar radius lg" style="background-image:url({{imageBaseUrl}}{{ item.image }});"></view>
                        <view class='content canui-xzwz tow' style="padding: 10px;">
                            {{ item.name }}
                            <!-- <view wx:if="{{ item.type == 1 }}">食品</view>
                            <view wx:if="{{ item.type == 2 }}">饮品</view>
                            <view wx:if="{{ item.type == 3 }}">药品</view> -->
                        </view>
                        <view class='action'>
                            <view class='text-price'>{{ item.unitPrice * item.commodityNum }}</view>
                            <view class="text-xs text-right text-gray">x{{item.commodityNum}}</view>
                        </view>
                    </view>
                </view>
            </navigator>
            <view class="cu-list menu bg-white solid-bottom canui-selet">
                <view class="cu-item">
                    <view class='content'>
                    共 <text class="text-red"> {{item.commodityNum}}</text> 桶商品
                    </view>
                    <view class='action'>
                        合计 <text class="text-price text-red">{{ item.unitPrice * item.commodityNum }}</text>
                    </view>
                </view>
                <!-- <view class="cu-item arrow">
                    <view class='content'>会员卡</view>
                    <view class='action'>
                        无可用
                    </view>
                </view> -->
            </view>
            <view class="cu-item ticket-controls">
                <view class='content'>购买桶数</view>
                <view class='action quantity-stepper'>
                    <button class="cu-btn sm line-gray" data-index="{{index}}" data-delta="-1" bindtap="adjustQuantity">-</button>
                    <text>{{item.commodityNum}}</text>
                    <button class="cu-btn sm line-gray" data-index="{{index}}" data-delta="1" bindtap="adjustQuantity">+</button>
                </view>
            </view>
            <view class="cu-item ticket-controls" wx:if="{{item.ticketAvailable > 0}}">
                <view class='content'>使用水票 <text class="text-gray text-sm">可用 {{item.ticketAvailable}} 桶</text></view>
                <view class='action quantity-stepper'>
                    <button class="cu-btn sm line-gray" data-index="{{index}}" data-delta="-1" bindtap="adjustTicket">-</button>
                    <text>{{item.ticketNum}}</text>
                    <button class="cu-btn sm line-gray" data-index="{{index}}" data-delta="1" bindtap="adjustTicket">+</button>
                </view>
            </view>
            <!-- <view class="cu-form-group bg-white canui-input">
                <view class='title'>备注</view>
                <input placeholder="两字短标题" class='radius' name='input'></input>
            </view> -->
        </view>
    </view>

    <view class="canui-coupon">
        <view class="cu-list menu bg-white solid-bottom canui-selet">
            <view class="cu-item arrow" bindtap="showCoupons">
                <view class='content'>优惠券</view>
                <view class='action'>
                    <text wx:if="{{selectedUserCouponId}}" class="text-red">{{selectedCouponName}} · -¥{{couponDiscount}}</text>
                    <text wx:elif="{{quoteLoading}}" class="text-gray">正在计算</text>
                    <text wx:elif="{{quoteError}}" class="text-red">计算失败，请重试</text>
                    <text wx:else class="text-gray">{{availableCouponCount > 0 ? availableCouponCount + ' 张可用，点击选择' : '暂无可用优惠券'}}</text>
                </view>
            </view>
        </view>
        <view class="coupon-rule">每次结算限用一张；水票抵扣后计算优惠，商品专用券仅抵扣关联商品。</view>
        <view wx:if="{{quoteError}}" class="coupon-retry" bindtap="refreshQuote">重新计算优惠</view>
    </view>

    <view class="order-price-log">
        <view class="bg-white log-card">
            <view class="log-list">
                <text>商品总价</text> <text class="text-price canui-text-right">{{ allPrice }}</text>
            </view>
            <view class="log-list" wx:if="{{orderList.length}}">
                <text>水票抵扣（{{totalTicketNum}} 桶）</text> <text class="canui-text-right text-green">-¥{{ticketDiscount}}</text>
            </view>
            <view class="log-list"><text>优惠券抵扣</text><text class="canui-text-right text-red">-¥{{couponDiscount}}</text></view>
            <!-- <view class="log-list">
                <text>运费(快递)</text> <text class="text-price canui-text-right text-red">0.00</text>
            </view> -->
            <view class="log-list bg-white text-df">
                <text>实付金额</text>
                <text class="text-price canui-text-right text-red">{{ cashPrice }}</text>
            </view>
        </view>
    </view>

</view>

<view class="bg-white canui-foor-fixed canui-submit-view {{TabbarBot=='y'?'canui-submit-order':''}}">
    <view class="bg-red light text-sm canui-pay-tip">下单后将安排配送，请收到商品后确认收货</view>
    <view class="canui-submit">
        <text class='text-red text-price canui-price'>{{ cashPrice }}</text>
        <button class="bg-red canui-submit-btn" disabled="{{submitting || quoteLoading || quoteError}}" loading="{{submitting}}" bindtap="submit">{{quoteLoading ? '计算中' : submitting ? '提交中' : '提交订单'}}</button>
    </view>
</view>

<view wx:if="{{couponModal}}" class="coupon-mask" bindtap="closeCoupons">
    <view class="coupon-sheet" catchtap="preventClose">
        <view class="coupon-sheet-heading"><text>选择优惠券</text><text bindtap="closeCoupons">关闭</text></view>
        <view class="coupon-rule">全场通用券适用全部商品；商品专用券仅抵扣本次结算中符合范围的商品。</view>
        <view class="coupon-none" bindtap="chooseCoupon">不使用优惠券 <text wx:if="{{!selectedUserCouponId}}" class="text-green">✓</text></view>
        <scroll-view scroll-y class="coupon-scroll">
            <view wx:if="{{!couponOptions.length}}" class="coupon-empty">暂无已领取的优惠券</view>
            <view wx:for="{{couponOptions}}" wx:key="userCouponId" class="checkout-coupon {{item.available ? '' : 'coupon-disabled'}} {{selectedUserCouponId == item.userCouponId ? 'coupon-selected' : ''}}" data-id="{{item.userCouponId}}" bindtap="chooseCoupon">
                <view class="coupon-value">{{item.valueText}}</view>
                <view class="coupon-info">
                    <view class="coupon-name">{{item.name}}</view>
                    <view>{{item.scopeText}}</view>
                    <view>{{item.conditionText}}</view>
                    <view>到期时间：{{item.expireTime}}</view>
                    <view wx:if="{{item.available}}" class="text-red">本单可省 ¥{{item.discountText}} {{selectedUserCouponId == item.userCouponId ? '✓' : ''}}</view>
                    <view wx:else class="coupon-unavailable">{{item.reason}}</view>
                </view>
            </view>
        </scroll-view>
        <view class="coupon-center-link" bindtap="couponCenter">去优惠中心领券 <text class="icon-right"></text></view>
    </view>
</view>
